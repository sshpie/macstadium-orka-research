<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.orka.vm.tools</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>ORKA_VM_TOOLS_PATH</key>
      <string>/Applications/orka-vm-tools</string>
    </dict>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/orka-vm-tools/orka-vm-tools</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/orka-vm-tools.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/orka-vm-tools.log</string>
</dict>
</plist>
